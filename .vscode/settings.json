{
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (pdflatex + biber)",
      "tools": ["latexmk"]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk (pdflatex + biber)",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.clean.fileExtensions": [
    "*.aux", "*.bbl", "*.bcf", "*.blg", "*.idx", "*.ind", "*.lof",
    "*.lot", "*.out", "*.toc", "*.acn", "*.acr", "*.alg", "*.glg",
    "*.glo", "*.gls", "*.ist", "*.fls", "*.log", "*.fdb_latexmk",
    "*.run.xml", "*.synctex.gz"
  ],
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.outDir": "%DIR%",
  "[tex]": {
    "editor.wordWrap": "on"
  },
  "[latex]": {
    "editor.wordWrap": "on"
  },
  "cSpell.language": "en",
  "cSpell.enableFiletypes": ["latex", "tex"]
}
